        { "id": "brakes", "role": "pilot", "action": "set-brakes", "after": ["set-brakes-signal"], "delay": 2 },
        { "id": "cut-signal", "role": "marshaller", "action": "signal-cut-engines", "after": ["brakes"], "delay": 1 },
        { "id": "engines", "role": "pilot", "action": "engines-off", "after": ["cut-signal"], "delay": 3 },
        { "id": "beacon", "role": "pilot", "action": "beacon-off", "after": ["engines"], "delay": 6 },
        { "id": "chock-nose", "role": "lead", "action": "chock-nose", "after": ["beacon"], "delay": 2 },
        { "id": "chock-mains", "role": "lead", "action": "chock-mains", "after": ["chock-nose"], "delay": 4 },
        { "id": "chocks-signal", "role": "marshaller", "action": "signal-chocks-in", "after": ["chock-mains"], "delay": 1 },
        { "id": "cones", "role": "lead", "action": "cones-out", "after": ["chock-mains"], "delay": 3 },
        { "id": "walkaround", "role": "lead", "action": "walkaround", "after": ["cones"], "delay": 4 },
        { "id": "dock", "role": "bridge", "action": "bridge-dock", "after": ["chocks-signal"], "delay": 2 },
        { "id": "door", "role": "bridge", "action": "door-open", "after": ["dock"], "delay": 3 },
        { "id": "gpu", "role": "lead", "action": "gpu-connect", "after": ["chocks-signal"], "delay": 2 },
        { "id": "apu", "role": "pilot", "action": "apu-off", "after": ["gpu"], "delay": 4 },
        { "id": "pca", "role": "lead", "action": "pca-connect", "after": ["gpu"], "delay": 3 },
        { "id": "belt", "role": "lead", "action": "beltloader-in", "after": ["walkaround"], "delay": 2 },
