        { "id": "stowed", "role": "bridge", "action": "bridge-stowed", "delay": 1 },
        { "id": "stage", "role": "lead", "action": "stage-chocks-cones", "after": ["clear"] },
        { "id": "marshal-pos", "role": "marshaller", "action": "marshaller-position", "after": ["clear"] },
        { "id": "wwl-pos", "role": "wingwalkerL", "action": "wingwalkerL-position", "after": ["clear"] },
        { "id": "wwr-pos", "role": "wingwalkerR", "action": "wingwalkerR-position", "after": ["clear"] },
        { "id": "in-sight", "event": "aircraft-in-sight", "after": ["stowed", "stage", "marshal-pos", "wwl-pos", "wwr-pos"] },
        { "id": "this-way", "role": "marshaller", "action": "signal-this-way", "after": ["in-sight"], "delay": 1 },
        { "id": "come-ahead", "role": "marshaller", "action": "signal-come-ahead", "after": ["this-way"], "delay": 3 },
        { "id": "entering", "event": "aircraft-entering", "after": ["come-ahead"] },
        { "id": "slow", "role": "marshaller", "action": "signal-slow", "after": ["entering"], "live": true },
        { "id": "stop", "role": "marshaller", "action": "signal-stop", "after": ["slow"], "live": true },
        { "id": "stopped", "event": "aircraft-stopped", "after": ["stop"] },
